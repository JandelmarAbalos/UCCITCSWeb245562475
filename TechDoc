body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
}

#navbar {
  position: fixed;
  left: 0;
  top: 0;
  width: 230px;
  height: 100%;
  background: #222;
  padding: 20px;
  color: white;
}

#navbar header {
  font-size: 20px;
  margin-bottom: 20px;
}

.nav-link {
  display: block;
  color: white;
  padding: 8px 0;
  text-decoration: none;
}

.nav-link:hover {
  text-decoration: underline;
}

#main-doc {
  margin-left: 250px;
  padding: 20px;
}

header {
  font-size: 22px;
  margin-bottom: 10px;
}

@media (max-width: 600px) {
  #navbar {
    width: 100%;
    height: auto;
    position: relative;
  }
  #main-doc {
    margin-left: 0;
  }
}
